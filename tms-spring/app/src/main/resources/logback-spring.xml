<?xml version="1.0" encoding="UTF-8"?>
<!--
  TMS Spring Boot — logback-spring.xml
  ─────────────────────────────────────────────────────────────────
  목적: 모든 SQL(조회/DML) 을 stdout.log 에 기록
  출력 채널: stdout (→ systemd journal / stdout.log)
  포맷:
    [SQL]  실행된 SQL 전문
    [BIND] 바인드 파라미터 값 목록
  ─────────────────────────────────────────────────────────────────
-->
<configuration scan="true" scanPeriod="30 seconds">

  <!-- ── 공통 패턴 ──────────────────────────────────────────── -->
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%15.15thread] %-50.50logger{50} : %msg%n"/>

  <!-- ── stdout Appender (콘솔 → systemd stdout.log) ───────── -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ── 애플리케이션 로거 ────────────────────────────────────── -->
  <!-- DEBUG: DeliveryService.log.debug() 등 서비스 레이어 디버그 출력 활성 -->
  <logger name="com.company" level="DEBUG" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- ── TMS 완성쿼리 로거 ─────────────────────────────────────
       ShipmentService 에서 [QUERY-PARAMS] / [BOUND-SQL] 태그로 출력
       ? 를 실제 바인드값으로 치환한 완성쿼리를 stdout.log 에 기록
  ──────────────────────────────────────────────────────────── -->
  <logger name="TMS_QUERY_LOG" level="INFO" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- ── Hibernate NativeQuery SQL 로거 ──────────────────────
       org.hibernate.SQL              : 실행 SQL 전문 (DEBUG)
       org.hibernate.orm.jdbc.bind    : 바인드 파라미터 — Hibernate 6.x (TRACE)
       org.hibernate.type.descriptor.sql : 바인드 파라미터 — Hibernate 5.x 호환 (TRACE)
       org.hibernate.engine.jdbc      : JDBC 레벨 SQL/파라미터 (DEBUG)
  ──────────────────────────────────────────────────────────── -->
  <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>
  <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>
  <!-- Hibernate 5.x / 6.x 호환 파라미터 로거 -->
  <logger name="org.hibernate.type.descriptor.sql" level="TRACE" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>
  <!-- Hibernate 6 NativeQuery 바인딩 추가 로거 -->
  <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="WARN" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- ── Spring JdbcTemplate SQL 로거 ─────────────────────────
       JdbcTemplate 은 org.springframework.jdbc.core 채널로 SQL 출력
  ──────────────────────────────────────────────────────────── -->
  <logger name="org.springframework.jdbc.core.JdbcTemplate" level="DEBUG" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>
  <logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="TRACE" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- ── 루트 로거 ─────────────────────────────────────────── -->
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
